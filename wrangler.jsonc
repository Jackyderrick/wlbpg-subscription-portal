{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dns-sub-share",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "DNS_SUFFIX": "ddda.dpdns.org",
    "CF_ZONE_ID": "ed0b451b965e84addf0757d3bf2086ee",
    "DNS_POOLS": "[{\"suffix\":\"ddda.dpdns.org\",\"zoneId\":\"ed0b451b965e84addf0757d3bf2086ee\",\"maxRecords\":190},{\"suffix\":\"subwlbpg.ggff.net\",\"zoneId\":\"76db1207ea8d1132e3f40702c6d9d36e\",\"maxRecords\":190},{\"suffix\":\"subwlbpg.kdns.fr\",\"zoneId\":\"16d1fcec8ef216b42c42532ab3425110\",\"maxRecords\":190},{\"suffix\":\"wlbpg.kdns.fr\",\"zoneId\":\"929e19c968647c9b3d1fb4f331c541a7\",\"maxRecords\":190}]",
    "DNS_SUBREQUEST_BUDGET": "250",
    "DNS_CONCURRENCY": "4",
    "BOOTSTRAP_PER_IP_MINUTE": "60",
    "BOOTSTRAP_NEW_DEVICE_PER_IP_HOUR": "30",
    "APP_UPDATE_WINDOWS_VERSION": "4.3.0",
    "APP_UPDATE_WINDOWS_NOTES": "【新版本体验】外贸加速器 v4.3.0 正式发布！新增左侧独立设置中心，优化分流策略与节点稳定性。",
    "APP_UPDATE_VERSION_CODE": "10009",
    "APP_UPDATE_VERSION_NAME": "1.15.0-alpha.13",
    "APP_UPDATE_APK_URL": "https://pub-a875cd2b61b44fd0b04710f9bb172bdb.r2.dev/android/waimao-accelerator-latest.apk",
    "APP_UPDATE_RELEASE_URL": "https://pub-a875cd2b61b44fd0b04710f9bb172bdb.r2.dev/android/waimao-accelerator-1.15.0-alpha.13.apk",
    "APP_UPDATE_MESSAGE": "1. 修复启动守护与并发防重互斥，消灭冷启动与多开竞态\n2. 补全 R2 下载与 MotionPay 支付直连白名单，杜绝任何分流死锁\n3. 修复停售/下架套餐在途订单与用户状态识别\n4. 全协议节点支持（Hysteria2、AnyTLS、SS-2022 等）",
    "APP_UPDATE_FORCE": "false",
    "APP_UPDATE_SHA256": "8B930FBD6AFB3EDEAB25FA6148259499AFCFA61B63C88BDA23DB311433D353FB"
  },
  "r2_buckets": [
    {
      "binding": "APP_RELEASES",
      "bucket_name": "waimao-app-releases"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dns-sub-share-db",
      "database_id": "6aeabe5f-4e14-4ae8-bc32-8442b0bbbfed",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *", "*/15 * * * *", "7 * * * *"]
  }
}
